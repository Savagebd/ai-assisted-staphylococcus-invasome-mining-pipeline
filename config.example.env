# Example configuration for the AI-Assisted Staphylococcus Invasome Mining Pipeline
# Copy this file to config.env, then edit the values for your computer and sample.

PROJECT_DIR="$HOME/bioinformatics/09_Projects/staph_invasome_test_project"
SAMPLE_ID="staph_invasome_sample"
GENOME_FASTA="${PROJECT_DIR}/01_Genome_FASTA/sample.fasta"
THREADS="4"
BAKTA_DB="$HOME/bioinformatics/06_Tools/bakta_db/db-light"

# Optional AMRFinderPlus database.
# Leave empty to let AMRFinderPlus use its default database location.
AMRFINDER_DB=""

# Optional ABRicate virulence/database screening.
# Set RUN_ABRICATE="false" to skip this module.
# ABRICATE_DB is commonly "vfdb" after ABRicate databases are installed and configured.
RUN_ABRICATE="true"
ABRICATE_DB="vfdb"
